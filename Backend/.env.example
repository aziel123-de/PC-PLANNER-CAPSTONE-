# Backend environment example for PC-PLANNER-CAPSTONE
# Copy this file to `.env` and fill in real values before running the backend.

# Server
PORT=5050

# Database (use a dedicated, non-root user for local dev)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pc_planner_db
DB_USER=pcplanner
DB_PASS=please-change-me

# JWT secret for signing tokens (change in production)
JWT_SECRET=change-me

# Notes:
# - Do NOT commit a real `.env` to git. Keep credentials secret.
# - If you use MySQL Workbench or Docker, make sure DB_HOST/DB_PORT match the service.
# - The backend reads these exact env names: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASS, JWT_SECRET
